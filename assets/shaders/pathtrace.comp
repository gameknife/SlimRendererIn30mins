#version 460

// SlimRender path tracer.
//
// One invocation per pixel adds a single sample to a running average. Rays are traced
// inline with GL_EXT_ray_query, so there is no ray tracing pipeline and no shader
// binding table: this is an ordinary compute shader that happens to hit the BVH units.
// All scene data arrives as 64-bit pointers in the push constants (buffer_reference),
// which is why the descriptor set only holds the TLAS, two images and the textures.

#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumulationImage; // running sum
layout(set = 0, binding = 2, rgba8) uniform image2D outputImage;         // tonemapped copy
layout(set = 0, binding = 3) uniform sampler2D textures[];

// These four structs mirror src/Scene/SceneTypes.hpp exactly. `scalar` layout is what
// makes that possible: members sit at their natural C offsets, with no std140/std430
// padding rules to work around.
struct Vertex {
    vec4 pos;    // xyz = position, w = uv.x
    vec4 normal; // xyz = normal,   w = uv.y
};

struct Material {
    vec4 baseColorFactor;
    vec4 emissiveFactor;
    float metallicFactor;
    float roughnessFactor;
    int baseColorTextureIndex;
};

struct InstanceData {
    mat4 transform;
    mat4 invTransform;
    uint vertexOffset;
    uint indexOffset;
    uint materialIndex;
};

struct CameraUBO {
    mat4 invView;
    mat4 invProj;
    vec4 cameraPos;
};

layout(buffer_reference, scalar) readonly buffer CameraBuffer { CameraUBO camera; };
layout(buffer_reference, scalar) readonly buffer VertexBuffer { Vertex vertices[]; };
layout(buffer_reference, scalar) readonly buffer IndexBuffer { uint indices[]; };
layout(buffer_reference, scalar) readonly buffer MaterialBuffer { Material materials[]; };
layout(buffer_reference, scalar) readonly buffer InstanceBuffer { InstanceData instances[]; };

layout(push_constant) uniform PushConstants {
    vec4 sunDirectionAndIntensity; // xyz = direction towards the sun, w = intensity
    vec4 sunColorAndSky;           // rgb = sun colour, a = sky intensity
    uint64_t cameraAddress;
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint64_t materialAddress;
    uint64_t instanceAddress;
    uint frameIndex;
    uint maxBounces;
    uint width;
    uint height;
} pc;

const float PI = 3.141592653589793;
const float RAY_EPSILON = 0.001;  // pushes ray origins off the surface they start on
const float RAY_MAX = 10000.0;
const float DIELECTRIC_F0 = 0.04; // reflectance of a non-metal at normal incidence

// PCG hash: cheap, and decorrelated enough that neighbouring pixels do not share noise.
uint pcgHash(inout uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    seed = (word >> 22u) ^ word;
    return seed;
}

float rand(inout uint seed) {
    return float(pcgHash(seed)) * (1.0 / 4294967296.0); // [0, 1)
}

vec2 rand2(inout uint seed) {
    return vec2(rand(seed), rand(seed));
}

// Filmic curve that compresses HDR radiance into [0, 1] without clipping highlights.
vec3 ACESFilm(vec3 color) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((color * (a * color + b)) / (color * (c * color + d) + e), 0.0, 1.0);
}

// Analytic sky: a zenith-to-horizon gradient plus a small bright sun disc.
vec3 SampleSky(vec3 direction, vec3 sunDirection, vec3 sunRadiance, float skyIntensity, bool includeSun) {
    float height = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 sky = mix(vec3(0.7, 0.82, 0.95), vec3(0.18, 0.38, 0.78), height) * skyIntensity;
    if (includeSun) {
        sky += sunRadiance * pow(max(dot(direction, sunDirection), 0.0), 128.0) * 4.0;
    }
    return sky;
}

// Builds an orthonormal basis around `normal` so local-space samples can be rotated into
// world space with T * x + B * y + N * z.
void BuildBasis(vec3 normal, out vec3 tangent, out vec3 bitangent) {
    vec3 helper = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(helper, normal));
    bitangent = cross(normal, tangent);
}

bool TraceShadowRay(vec3 origin, vec3 direction) {
    rayQueryEXT query;
    // TerminateOnFirstHit: any occluder will do, the closest one is not needed.
    rayQueryInitializeEXT(query, topLevelAS,
                          gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                          origin, RAY_EPSILON, direction, RAY_MAX);
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionTriangleEXT;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return; // the dispatch is rounded up to whole workgroups
    }

    uint seed = (pixel.y * pc.width + pixel.x) ^ (pc.frameIndex * 1999999973u);

    // Jitter inside the pixel so that averaging the frames also antialiases the edges.
    // The very first frame stays centred, which keeps the initial preview crisp.
    vec2 jitter = pc.frameIndex == 0 ? vec2(0.5) : rand2(seed);
    vec2 ndc = ((vec2(pixel) + jitter) / vec2(pc.width, pc.height)) * 2.0 - 1.0;

    CameraUBO cam = CameraBuffer(pc.cameraAddress).camera;
    vec4 viewTarget = cam.invProj * vec4(ndc, 1.0, 1.0);
    vec3 rayOrigin = cam.cameraPos.xyz;
    vec3 rayDir = normalize((cam.invView * vec4(normalize(viewTarget.xyz / viewTarget.w), 0.0)).xyz);

    vec3 sunDir = normalize(pc.sunDirectionAndIntensity.xyz);
    vec3 sunRadiance = pc.sunColorAndSky.rgb * pc.sunDirectionAndIntensity.w;
    float skyIntensity = pc.sunColorAndSky.a;

    vec3 radiance = vec3(0.0);   // light gathered along this path
    vec3 throughput = vec3(1.0); // how much of it still reaches the camera

    // The sun is sampled explicitly at every diffuse hit (next-event estimation), so a
    // diffuse bounce that happens to fly into the sun disc would count it a second time.
    // Only the camera ray and specular bounces are allowed to see the disc.
    bool cameraOrSpecularRay = true;

    for (uint bounce = 0; bounce < pc.maxBounces; ++bounce) {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                              rayOrigin, RAY_EPSILON, rayDir, RAY_MAX);
        while (rayQueryProceedEXT(query)) {} // opaque geometry only, so this never iterates

        if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
            radiance += throughput * SampleSky(rayDir, sunDir, sunRadiance, skyIntensity, cameraOrSpecularRay);
            break;
        }

        // --- Reconstruct the hit ------------------------------------------------------
        // Ray query hands back indices and barycentrics; the vertex data is fetched by
        // address, exactly as a closest-hit shader would.
        uint instanceIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
        vec3 weights = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y);

        InstanceData inst = InstanceBuffer(pc.instanceAddress).instances[instanceIndex];
        IndexBuffer indexBuffer = IndexBuffer(pc.indexAddress);
        VertexBuffer vertexBuffer = VertexBuffer(pc.vertexAddress);

        uint triangle = inst.indexOffset + primitiveIndex * 3;
        Vertex v0 = vertexBuffer.vertices[inst.vertexOffset + indexBuffer.indices[triangle + 0]];
        Vertex v1 = vertexBuffer.vertices[inst.vertexOffset + indexBuffer.indices[triangle + 1]];
        Vertex v2 = vertexBuffer.vertices[inst.vertexOffset + indexBuffer.indices[triangle + 2]];

        vec3 localPos = v0.pos.xyz * weights.x + v1.pos.xyz * weights.y + v2.pos.xyz * weights.z;
        vec3 localNormal = v0.normal.xyz * weights.x + v1.normal.xyz * weights.y + v2.normal.xyz * weights.z;
        vec2 uv = vec2(v0.pos.w, v0.normal.w) * weights.x +
                  vec2(v1.pos.w, v1.normal.w) * weights.y +
                  vec2(v2.pos.w, v2.normal.w) * weights.z;

        vec3 worldPos = (inst.transform * vec4(localPos, 1.0)).xyz;
        // Normals transform by the inverse transpose, or non-uniform scaling shears them.
        vec3 normal = normalize(transpose(mat3(inst.invTransform)) * localNormal);
        if (dot(normal, rayDir) > 0.0) {
            normal = -normal; // geometry is double sided; always shade the side we hit
        }

        // --- Material -----------------------------------------------------------------
        Material mat = MaterialBuffer(pc.materialAddress).materials[inst.materialIndex];
        vec4 baseColor = mat.baseColorFactor;
        if (mat.baseColorTextureIndex >= 0) {
            baseColor *= texture(textures[nonuniformEXT(mat.baseColorTextureIndex)], uv);
        }

        float metallic = clamp(mat.metallicFactor, 0.0, 1.0);
        float roughness = clamp(mat.roughnessFactor, 0.04, 1.0);
        // Metals have no diffuse lobe: their base colour tints the reflection instead.
        vec3 diffuseAlbedo = baseColor.rgb * (1.0 - metallic);

        radiance += throughput * mat.emissiveFactor.rgb;

        // --- Direct light: one shadow ray towards the sun ------------------------------
        float NdotL = max(dot(normal, sunDir), 0.0);
        if (NdotL > 0.0 && TraceShadowRay(worldPos + normal * RAY_EPSILON, sunDir)) {
            // Lambert BRDF (albedo / PI) times the sun irradiance.
            radiance += throughput * (diffuseAlbedo / PI) * NdotL * sunRadiance;
        }

        // --- Indirect light: pick one lobe and follow it -------------------------------
        // Choosing between the lobes with probability `specularProbability` and dividing
        // the weight by that probability keeps the estimator unbiased.
        vec3 tangent, bitangent;
        BuildBasis(normal, tangent, bitangent);

        float specularProbability = mix(DIELECTRIC_F0, 1.0, metallic);
        if (rand(seed) < specularProbability) {
            // GGX: importance sample a microfacet normal, then reflect about it.
            vec2 r = rand2(seed);
            float alpha = roughness * roughness;
            float phi = 2.0 * PI * r.x;
            float cosTheta = sqrt((1.0 - r.y) / (1.0 + (alpha * alpha - 1.0) * r.y));
            float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
            vec3 halfVector = normalize(tangent * (sinTheta * cos(phi)) +
                                        bitangent * (sinTheta * sin(phi)) +
                                        normal * cosTheta);

            rayDir = reflect(rayDir, halfVector);
            // Fresnel at normal incidence divided by the selection probability: white for
            // dielectrics, the base colour for metals. The masking-shadowing term is
            // approximated as 1, which is where this stops being a reference renderer.
            throughput *= mix(vec3(1.0), baseColor.rgb, metallic);
            cameraOrSpecularRay = true;
        } else {
            // Cosine-weighted hemisphere sampling: the cosine in the rendering equation
            // and the pdf cancel, leaving just the albedo.
            vec2 r = rand2(seed);
            float phi = 2.0 * PI * r.x;
            float cosTheta = sqrt(r.y);
            float sinTheta = sqrt(max(0.0, 1.0 - r.y));
            rayDir = normalize(tangent * (sinTheta * cos(phi)) +
                               bitangent * (sinTheta * sin(phi)) +
                               normal * cosTheta);

            throughput *= diffuseAlbedo / (1.0 - specularProbability);
            cameraOrSpecularRay = false;
        }

        rayOrigin = worldPos + normal * RAY_EPSILON;

        // --- Russian roulette ----------------------------------------------------------
        // Kill dim paths at random and scale the survivors up, so the average is
        // unchanged but the expensive deep bounces are only paid for when they matter.
        if (bounce >= 2) {
            float survivalChance = max(throughput.r, max(throughput.g, throughput.b));
            if (survivalChance < 0.001 || rand(seed) > survivalChance) {
                break;
            }
            throughput /= survivalChance;
        }
    }

    // Accumulate. frameIndex 0 starts a new average, which is how camera or material
    // edits discard everything gathered so far.
    vec3 accumulated = radiance;
    if (pc.frameIndex > 0) {
        accumulated += imageLoad(accumulationImage, pixel).rgb;
    }
    imageStore(accumulationImage, pixel, vec4(accumulated, 1.0));

    vec3 color = ACESFilm(accumulated / float(pc.frameIndex + 1));
    color = pow(color, vec3(1.0 / 2.2)); // the swapchain is UNORM, so encode sRGB here
    imageStore(outputImage, pixel, vec4(color, 1.0));
}
