#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumulationImage;
layout(set = 0, binding = 2, rgba8) uniform image2D outputImage;
layout(set = 0, binding = 3) uniform sampler2D textures[];

struct Vertex {
    vec4 pos;    // xyz = position, w = uv.x
    vec4 normal; // xyz = normal,   w = uv.y
};

struct Material {
    vec4 baseColorFactor;
    vec4 emissiveFactor;
    float metallicFactor;
    float roughnessFactor;
    int baseColorTextureIndex;
    int pad0;
};

struct InstanceData {
    mat4 transform;
    mat4 invTransform;
    uint vertexOffset;
    uint indexOffset;
    uint materialIndex;
    uint pad;
};

struct CameraUBO {
    mat4 invView;
    mat4 invProj;
    vec4 cameraPos;
};

layout(buffer_reference, scalar) readonly buffer CameraBuffer { CameraUBO camera; };
layout(buffer_reference, scalar) readonly buffer VertexBuffer { Vertex vertices[]; };
layout(buffer_reference, scalar) readonly buffer IndexBuffer { uint indices[]; };
layout(buffer_reference, scalar) readonly buffer MaterialBuffer { Material materials[]; };
layout(buffer_reference, scalar) readonly buffer InstanceBuffer { InstanceData instances[]; };

layout(push_constant) uniform PushConstants {
    uint64_t cameraAddress;
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint64_t materialAddress;
    uint64_t instanceAddress;
    uint64_t tlasHandle;
    uint frameIndex;
    uint maxBounces;
    uint numSamples;
    uint width;
    uint height;
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 sunDirectionAndIntensity;
    vec4 sunColorAndSky;
} pc;

const float PI = 3.141592653589793;

uint pcg_hash(inout uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    seed = (word >> 22u) ^ word;
    return seed;
}

float rand(inout uint seed) {
    return float(pcg_hash(seed)) / 4294967295.0;
}

vec2 rand2(inout uint seed) {
    return vec2(rand(seed), rand(seed));
}

vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    uint seed = (pixel.y * pc.width + pixel.x) ^ (pc.frameIndex * 1999999973u);

    CameraUBO cam = CameraBuffer(pc.cameraAddress).camera;

    // Sub-pixel jitter for anti-aliasing
    vec2 jitter = (pc.frameIndex == 0) ? vec2(0.5) : rand2(seed);
    vec2 uv = (vec2(pixel) + jitter) / vec2(pc.width, pc.height);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 target = cam.invProj * vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec3 rayOrigin = cam.cameraPos.xyz;
    vec3 rayDir = normalize((cam.invView * vec4(normalize(target.xyz / target.w), 0.0)).xyz);

    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);

    vec3 sunDir = normalize(pc.sunDirectionAndIntensity.xyz);
    vec3 sunColor = pc.sunColorAndSky.rgb * pc.sunDirectionAndIntensity.w;
    float skyIntensity = pc.sunColorAndSky.w;

    for (uint bounce = 0; bounce < pc.maxBounces; ++bounce) {
        rayQueryEXT q;
        rayQueryInitializeEXT(q, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                              rayOrigin, 0.001, rayDir, 10000.0);
        while (rayQueryProceedEXT(q)) {}

        if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
            // Missed geometry -> sample physical sky
            float sunDot = max(dot(rayDir, sunDir), 0.0);
            vec3 skyGradient = mix(vec3(0.7, 0.82, 0.95), vec3(0.18, 0.38, 0.78), clamp(rayDir.y * 0.5 + 0.5, 0.0, 1.0)) * skyIntensity;
            vec3 sunDisc = sunColor * pow(sunDot, 128.0) * 4.0;
            radiance += throughput * (skyGradient + sunDisc);
            break;
        }

        // Triangle Hit
        uint instCustomIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(q, true);
        uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(q, true);
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(q, true);
        vec3 baryCoord = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);

        InstanceData inst = InstanceBuffer(pc.instanceAddress).instances[instCustomIdx];

        uint i0 = IndexBuffer(pc.indexAddress).indices[inst.indexOffset + primIdx * 3 + 0];
        uint i1 = IndexBuffer(pc.indexAddress).indices[inst.indexOffset + primIdx * 3 + 1];
        uint i2 = IndexBuffer(pc.indexAddress).indices[inst.indexOffset + primIdx * 3 + 2];

        Vertex v0 = VertexBuffer(pc.vertexAddress).vertices[inst.vertexOffset + i0];
        Vertex v1 = VertexBuffer(pc.vertexAddress).vertices[inst.vertexOffset + i1];
        Vertex v2 = VertexBuffer(pc.vertexAddress).vertices[inst.vertexOffset + i2];

        vec3 objPos = v0.pos.xyz * baryCoord.x + v1.pos.xyz * baryCoord.y + v2.pos.xyz * baryCoord.z;
        vec3 objNorm = v0.normal.xyz * baryCoord.x + v1.normal.xyz * baryCoord.y + v2.normal.xyz * baryCoord.z;
        vec2 hitUV = vec2(v0.pos.w, v0.normal.w) * baryCoord.x +
                     vec2(v1.pos.w, v1.normal.w) * baryCoord.y +
                     vec2(v2.pos.w, v2.normal.w) * baryCoord.z;

        vec3 worldPos = (inst.transform * vec4(objPos, 1.0)).xyz;
        vec3 worldNorm = normalize(transpose(mat3(inst.invTransform)) * objNorm);

        // Face normal towards ray
        if (dot(worldNorm, -rayDir) < 0.0) {
            worldNorm = -worldNorm;
        }

        Material mat = MaterialBuffer(pc.materialAddress).materials[inst.materialIndex];
        vec4 baseColor = mat.baseColorFactor;
        if (mat.baseColorTextureIndex >= 0) {
            baseColor *= texture(textures[nonuniformEXT(mat.baseColorTextureIndex)], hitUV);
        }

        // Emissive light
        radiance += throughput * mat.emissiveFactor.rgb;

        // Next-Event Estimation (Direct Sun Light Shadow Ray)
        float NdotL = max(dot(worldNorm, sunDir), 0.0);
        if (NdotL > 0.0) {
            rayQueryEXT shadowQ;
            rayQueryInitializeEXT(shadowQ, topLevelAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                                  worldPos + worldNorm * 0.001, 0.001, sunDir, 10000.0);
            while (rayQueryProceedEXT(shadowQ)) {}

            if (rayQueryGetIntersectionTypeEXT(shadowQ, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
                radiance += throughput * (baseColor.rgb / PI) * NdotL * sunColor;
            }
        }

        // Scatter for next bounce
        vec3 N = worldNorm;
        vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        vec3 T = normalize(cross(up, N));
        vec3 B = cross(N, T);

        float metallic = clamp(mat.metallicFactor, 0.0, 1.0);
        float roughness = clamp(mat.roughnessFactor, 0.04, 1.0);

        // Specular lobe vs Diffuse lobe selection
        float specProb = mix(0.04, 1.0, metallic);
        if (rand(seed) < specProb) {
            // GGX Specular bounce
            vec2 r = rand2(seed);
            float a = roughness * roughness;
            float phi = 2.0 * PI * r.x;
            float cosThetaH = sqrt((1.0 - r.y) / (1.0 + (a * a - 1.0) * r.y));
            float sinThetaH = sqrt(max(0.0, 1.0 - cosThetaH * cosThetaH));
            vec3 H_local = vec3(sinThetaH * cos(phi), sinThetaH * sin(phi), cosThetaH);
            vec3 H = normalize(T * H_local.x + B * H_local.y + N * H_local.z);

            vec3 V = -rayDir;
            rayDir = reflect(-V, H);
            throughput *= mix(vec3(1.0), baseColor.rgb, metallic);
        } else {
            // Cosine-weighted Diffuse bounce
            vec2 r = rand2(seed);
            float phi = 2.0 * PI * r.x;
            float cosTheta = sqrt(r.y);
            float sinTheta = sqrt(max(0.0, 1.0 - r.y));
            vec3 localDir = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
            rayDir = normalize(T * localDir.x + B * localDir.y + N * localDir.z);
            throughput *= baseColor.rgb;
        }

        rayOrigin = worldPos + worldNorm * 0.001;

        // Russian Roulette path termination
        if (bounce >= 2) {
            float p = max(throughput.r, max(throughput.g, throughput.b));
            if (p < 0.001 || rand(seed) > p) {
                break;
            }
            throughput /= p;
        }
    }

    // Accumulate radiance across frames
    vec4 prevAccum = imageLoad(accumulationImage, pixel);
    vec3 accumColor;
    if (pc.frameIndex == 0) {
        accumColor = radiance;
    } else {
        accumColor = prevAccum.rgb + radiance;
    }
    imageStore(accumulationImage, pixel, vec4(accumColor, 1.0));

    // Tonemap and write to 8-bit output image
    vec3 avgColor = accumColor / float(pc.frameIndex + 1);
    vec3 ldrColor = ACESFilm(avgColor);
    ldrColor = pow(ldrColor, vec3(1.0 / 2.2)); // Gamma correction

    imageStore(outputImage, pixel, vec4(ldrColor, 1.0));
}
